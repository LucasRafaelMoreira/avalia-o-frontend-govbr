<!DOCTYPE html>
        <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Consultar Pessoa</title>
            <link rel="shortcut icon" type="imagex/png" href="./img/file.ico">
            <link rel="stylesheet" href="css/consultaPessoa.css" />
            <script type="text/javascript" src="js/pessoaFuncoes.js"></script>
        </head>
        <body>

            <header>
                <img src="/img/file.png" alt="Logo">
                <h1>Controle de Imóveis</h1>
            </header>

            <nav>
                <ul>
                    <li><a href="/">Página Inicial</a></li>
                    <li><a href="/cadastroPessoa">Cadastrar Pessoa</a></li>
                    <li><a href="/consultaPessoa">Consultar Pessoas</a></li>
                    <li><a href="/cadastroImovel">Cadastrar Imóvel</a></li>
                    <li><a href="/consultaImovel">Consultar Imóveis</a></li>
                    <li><a href="/iptu">Cálculo de IPTU</a></li>
                </ul>
            </nav>

            <br>
            <div class="container">

                <div class="form-container" onsubmit="event.preventDefault(); fetchClient();">
                    <form>
                        <div class="input-group">
                            <h2>Consultar Pessoa</h2>
                            <br>
                            <button type="submit">Buscar Pessoa</button>
                        </div>
                        <div class="input-group">
                            <h2>Remover Pessoa</h2>
                            <input type="text" id="clientId" name="clientId" placeholder="Digite o ID do cliente">
                            <br>
                            <button type="button" onclick="remover()">Remover Imóvel</button>
                        </div>
                    </form>
                </div>

                <table id="clientTable" border="1">
                    <thead>
                        <tr>
                          <th>Id</th>
                          <th>Nome Completo</th>
                          <th>Nascimento</th>
                          <th>CPF</th>
                          <th>Telefone</th>
                          <th>Endereço</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                    </tbody>
                </table>
            </div>

            <footer>
                &copy; 2025 Controle de Imóveis. Todos os direitos reservados.
            </footer>

        </body>
        </html>