<!DOCTYPE html>
        <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>IPTU</title>
            <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
            <link rel="stylesheet" href="css/iptu.css" />
        </head>
        <body>

            <header>
                <img src="/img/file.png" alt="Logo">
                <h1>Controle de Imóveis</h1>
            </header>

            <nav>
                <ul>
                    <li><a href="/">Página Inicial</a></li>
                    <li><a href="/cadastroPessoa">Cadastrar Pessoa</a></li>
                    <li><a href="/consultaPessoa">Consultar Pessoas</a></li>
                    <li><a href="/cadastroImovel">Cadastrar Imóvel</a></li>
                    <li><a href="/consultaImovel">Consultar Imóveis</a></li>
                    <li><a href="/iptu">Cálculo de IPTU</a></li>
                </ul>
            </nav>

            <br>
            <div class="container">

                <div class="form-container">
                    <form method="GET">
                        <div class="input-group">
                            <h2>Calcular IPTU</h2>
                            <br>
                            <input type="text" placeholder="Digite o ID do imóvel">
                            <br>
                            <button>Calcular IPTU</button>
                        </div>
                    </form>
                    
                    <div>
                        <h2>Resultado</h2>
                        <p class="valorIptu">Valor do IPTU: R$ 1000,00</p>
                    </div>
                </div>


            </div>

            <footer>
                &copy; 2025 Controle de Imóveis. Todos os direitos reservados.
            </footer>

        </body>
        </html>