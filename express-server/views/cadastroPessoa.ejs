<!DOCTYPE html>
        <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Cadastrar Pessoa</title>
            <link rel="shortcut icon" type="imagex/png" href="./img/file.ico">
            <link rel="stylesheet" href="css/cadastroPessoa.css" />
            <script type="text/javascript" src="js/pessoaFuncoes.js"></script>

        </head>
        <body>

            <header>
                <img src="/img/file.png" alt="Logo">
                <h1>Controle de Imóveis</h1>
            </header>

            <nav>
                <ul>
                    <li><a href="/">Página Inicial</a></li>
                    <li><a href="/cadastroPessoa">Cadastrar Pessoa</a></li>
                    <li><a href="/consultaPessoa">Consultar Pessoas</a></li>
                    <li><a href="/cadastroImovel">Cadastrar Imóvel</a></li>
                    <li><a href="/consultaPessoa">Consultar Imóveis</a></li>
                    <li><a href="/iptu">Cálculo de IPTU</a></li>
                </ul>
            </nav>

            <br>
            <div class="container">

                <main class="content">
                    <div class="form-container">
                        <h2>Cadastrar Pessoa</h2>
                        <form>
    
                            <div class="input-group">
                                <label for="nome">Nome Completo</label>
                                <input type="text" id="nome" name="nome" placeholder="Digite o nome completo" required>
                            </div>
                            <div class="input-group">
                                <label for="nascimento">Nascimento</label>
                                <input type="date" id="nascimento" name="nascimento" placeholder="Digite o nascimento" required>
                            </div>
                            <div class="input-group">
                                <label for="cpf">CPF</label>
                                <input type="number" maxlength="11" minlength="11" id="cpf" name="cpf" placeholder="Digite o CPF" required>
                            </div>
                            <div class="input-group">
                                <label for="telefone">Telefone</label>
                                <input type="phone" maxlength="11" minlength="11" id="telefone" name="telefone" placeholder="Digite o telefone" required>
                            </div>
                            <div class="input-group">
                                <label for="endereco">Endereço</label>
                                <input type="text" id="endereco" name="endereco" placeholder="Digite o valor do endereço" required>
                            </div>
                    
                            <button onclick="registrar()">Cadastrar</button>
                    
                    
                        </form>
                    </div>
                </main>
            </div>

            <footer>
                &copy; 2025 Controle de Imóveis. Todos os direitos reservados.
            </footer>

        </body>
        </html>