<!DOCTYPE html>
        <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Cadastrar Pessoa</title>
            <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
            <link rel="stylesheet" href="css/cadastroPessoa.css" />
            <script type="text/javascript" src="js/pessoaFuncoes.js"></script>

        </head>
        <body>

            <!-- Cabeçalho -->
            <header>
                <img src="/img/file.png" alt="Logo">
                <h1>Controle de Imóveis</h1>
            </header>

            <!-- Navbar -->
            <nav>
                <ul>
                    <li><a href="/">Página Inicial</a></li>
                    <li><a href="/cadastroPessoa">Cadastrar Pessoa</a></li>
                    <li><a href="/consultaPessoa">Consultar Pessoas</a></li>
                    <li><a href="/cadastroImovel">Cadastrar Imóvel</a></li>
                    <li><a href="/consultaPessoa">Consultar Imóveis</a></li>
                    <li><a href="/iptu">Cálculo de IPTU</a></li>
                </ul>
            </nav>

            <br>
            <!-- Conteúdo Principal -->
            <div class="container">

                <!-- Sidebar -->
                <!-- <aside class="sidebar"> -->
                    <!-- <a href="#"><span class="material-icons">facebook</span>Facebook</a>
                    <a href="#"><span class="material-icons">twitter</span>Twitter</a>
                    <a href="#"><span class="material-icons">instagram</span>Instagram</a>
                    <a href="#"><span class="material-icons">linkedin</span>LinkedIn</a> -->
                <!-- </aside> -->

                <!-- Conteúdo -->
                <main class="content">
                    <div class="form-container">
                        <h2>Cadastrar Pessoa</h2>
                        <form id="registrarPessoa">
    
                            <div class="input-group">
                                <label for="nome">Nome Completo</label>
                                <input type="text" id="nome" name="nome">
                            </div>
                            <div class="input-group">
                                <label for="nascimento">Nascimento</label>
                                <input type="date" id="nascimento" name="nascimento">
                            </div>
                            <div class="input-group">
                                <label for="cpf">CPF</label>
                                <input type="number" maxlength="11" minlength="11" id="cpf" name="cpf">
                            </div>
                            <div class="input-group">
                                <label for="telefone">Telefone</label>
                                <input type="phone" maxlength="11" minlength="11" id="telefone" name="telefone">
                            </div>
                            <div class="input-group">
                                <label for="endereco">Endereço</label>
                                <input type="text" id="endereco" name="endereco">
                            </div>
                    
                            <button onclick="registrar()">Cadastrar</button>
                    
                    
                        </form>
                    </div>
                </main>
            </div>

            <!-- Rodapé -->
            <footer>
                &copy; 2025 Controle de Imóveis. Todos os direitos reservados.
            </footer>

        </body>
        </html>