<!DOCTYPE html>
        <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Cadastrar Imóvel</title>
            <link rel="shortcut icon" type="imagex/png" href="./img/file.ico">
            <link rel="stylesheet" href="css/cadastroImovel.css" />
            <script type="text/javascript" src="js/imovelFuncoes.js"></script>
        </head>
        <body>

            <header>
                <img src="/img/file.png" alt="Logo">
                <h1>Controle de Imóveis</h1>
            </header>

            <nav>
                <ul>
                    <li><a href="/">Página Inicial</a></li>
                    <li><a href="/cadastroPessoa">Cadastrar Pessoa</a></li>
                    <li><a href="/consultaPessoa">Consultar Pessoas</a></li>
                    <li><a href="/cadastroImovel">Cadastrar Imóvel</a></li>
                    <li><a href="/consultaImovel">Consultar Imóveis</a></li>
                    <li><a href="/iptu">Cálculo de IPTU</a></li>
                </ul>
            </nav>

            <br>
            <div class="container">

                <main class="content">
                    <div class="form-container">
                        <h2>Cadastrar Imóvel</h2>
                        <form>
    
                            <div class="input-group">
                                <label for="nomePropietario">Nome do Proprietário</label>
                                <input type="text" id="nomePropietario" name="nomePropietario" placeholder="Digite o nome do proprietário" required>
                            </div>
                    
                            <div class="input-group">
                                <label for="endereco">Endereço</label>
                                <input type="text" id="endereco" name="endereco" placeholder="Digite o endereço do imóvel" required>
                            </div>
                    
                            <div class="input-group">
                                <label for="tipoImovel">Tipo do Imóvel</label>
                                <select id="tipoImovel" name="tipoImovel" required>
                                    <option value="residencial">Residencial</option>
                                    <option value="comercial">Comercial</option>
                                    <option value="terreno">Terrno</option>
                                    <option value="industrial">Industrial</option>
                                </select>
                            </div>
                    
                            <div class="input-group">
                                <label for="area">Área do Imóvel (m²)</label>
                                <input type="number" id="area" name="area" placeholder="Digite a área em m²" required>
                            </div>
                    
                            <div class="input-group">
                                <label for="valorImovel">Valor do Imóvel (R$)</label>
                                <input type="number" id="valorImovel" name="valorImovel" step="0.01" placeholder="Digite o valor do imóvel" required>
                            </div>

                            <div class="input-group">
                                <label for="aliquota">Alíoquota do Imóvel (%)</label>
                                <input type="number" id="aliquota" name="aliquota" step="0.01" placeholder="Digite a alíquota do imóvel" required>
                            </div>
                    
                            <div class="input-group">
                                <label for="dataRegistro">Data de Registro</label>
                                <input type="date" id="dataRegistro" name="dataRegistro" required>
                            </div>
                    
                            <button onclick="registrar()">Cadastrar</button>
                    
                    
                        </form>
                    </div>
                </main>
            </div>

            <footer>
                &copy; 2025 Controle de Imóveis. Todos os direitos reservados.
            </footer>

        </body>
        </html>