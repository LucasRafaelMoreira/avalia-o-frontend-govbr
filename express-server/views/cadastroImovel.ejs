<!DOCTYPE html>
        <html lang="pt-br">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Cadastrar Imóvel</title>
            <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
            <link rel="stylesheet" href="css/cadastroImovel.css" />
        </head>
        <body>

            <!-- Cabeçalho -->
            <header>
                <img src="/img/file.png" alt="Logo">
                <h1>Controle de Imóveis</h1>
            </header>

            <!-- Navbar -->
            <nav>
                <ul>
                    <li><a href="/">Página Inicial</a></li>
                    <li><a href="/cadastroPessoa">Cadastrar Pessoa</a></li>
                    <li><a href="/consultaPessoa">Consultar Pessoas</a></li>
                    <li><a href="/cadastroImovel">Cadastrar Imóvel</a></li>
                    <li><a href="/consultaImovel">Consultar Imóveis</a></li>
                    <li><a href="/iptu">Cálculo de IPTU</a></li>
                </ul>
            </nav>

            <br>
            <!-- Conteúdo Principal -->
            <div class="container">

                <!-- Sidebar -->
                <!-- <aside class="sidebar"> -->
                    <!-- <a href="#"><span class="material-icons">facebook</span>Facebook</a>
                    <a href="#"><span class="material-icons">twitter</span>Twitter</a>
                    <a href="#"><span class="material-icons">instagram</span>Instagram</a>
                    <a href="#"><span class="material-icons">linkedin</span>LinkedIn</a> -->
                <!-- </aside> -->

                <!-- Conteúdo -->
                <main class="content">
                    <div class="form-container">
                        <h2>Cadastrar Imóvel</h2>
                        <form action="/submit" method="POST">
    
                            <div class="input-group">
                                <label for="nomePropietario">Nome do Proprietário</label>
                                <input type="text" id="nomePropietario" name="nomePropietario" placeholder="Digite o nome do proprietário" required>
                            </div>
                    
                            <!-- Endereço do imóvel -->
                            <div class="input-group">
                                <label for="endereco">Endereço</label>
                                <input type="text" id="endereco" name="endereco" placeholder="Digite o endereço do imóvel" required>
                            </div>
                    
                            <!-- Tipo do imóvel -->
                            <div class="input-group">
                                <label for="tipoImovel">Tipo do Imóvel</label>
                                <select id="tipoImovel" name="tipoImovel" required>
                                    <option value="residencial">Residencial</option>
                                    <option value="comercial">Comercial</option>
                                    <option value="terreno">Terreno</option>
                                    <option value="industrial">Industrial</option>
                                </select>
                            </div>
                    
                            <!-- Área do imóvel -->
                            <div class="input-group">
                                <label for="area">Área do Imóvel (m²)</label>
                                <input type="number" id="area" name="area" placeholder="Digite a área em m²" required>
                            </div>
                    
                            <!-- Valor do imóvel -->
                            <div class="input-group">
                                <label for="value">Valor do Imóvel (R$)</label>
                                <input type="number" id="value" name="value" step="0.01" placeholder="Digite o valor do imóvel" required>
                            </div>
                    
                            <!-- Data de registro -->
                            <div class="input-group">
                                <label for="registration-date">Data de Registro</label>
                                <input type="date" id="registration-date" name="registration_date" required>
                            </div>
                    
                            <button type="submit">Cadastrar</button>
                    
                    
                        </form>
                    </div>
                </main>
            </div>

            <!-- Rodapé -->
            <footer>
                &copy; 2025 Controle de Imóveis. Todos os direitos reservados.
            </footer>

        </body>
        </html>